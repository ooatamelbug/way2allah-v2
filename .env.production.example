# Production environment TEMPLATE (P0 split layout, 2026-11-09) — placeholders only, no secrets.
# Copy to laravel-app/.env on the server and fill in every placeholder and blank secret there.
# Never commit or upload a filled-in copy. Keys mirror .env.example.

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_CANONICAL_HOST
# N3: force generated absolute URLs onto APP_URL (canonical host + scheme). Default off; enable only with a verified APP_URL.
# Production template value (2026-11-09): true. TEMPLATE ONLY — activating it on the server is a separate owner-approved
# step, after APP_URL above is replaced with the verified canonical https URL (an invalid APP_URL is refused at runtime).
APP_FORCE_ROOT_URL=true
APP_TIMEZONE=Africa/Cairo
ASSET_BASE_URL="${APP_URL}"
MEDIA_BASE_URL="${ASSET_BASE_URL}/media"
THUMBNAIL_BASE_URL="${ASSET_BASE_URL}/thumbnails.php"

# P0 split layout (2026-11-09) — REQUIRED in the split layout (application in laravel-app/, web root in newapp/).
# Absolute paths of the web root's media directories. public_path() is the web root only for HTTP requests;
# Artisan, queue workers and config:cache fall back to laravel-app/public, so these must never be left unset.
# Replace /absolute/path/to with the verified web root (e.g. /home/USER/newapp), then run
# `php artisan config:clear`, `php artisan config:cache` and `php artisan media:check-roots --expect-web-root=...`.
KHOTAB_MEDIA_ROOT=/absolute/path/to/media
ANASHEED_MEDIA_ROOT=/absolute/path/to/media
W2ACD_MEDIA_ROOT=/absolute/path/to/media
W2ACD_IMAGE_ROOT=/absolute/path/to/images/cds_image2
AUTOCOMPLETE_ROOT=/absolute/path/to/w2a_autocomplete

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Wave 0, task 0.2 (Blueprint v1.0 §8 / ADR-0011 / P-006) — required before
# the 'main'/'vbulletin'/'flashchat' connections in config/database.php can
# be used. Values are intentionally left blank here — do not fill this file
# with real or plausible-looking credentials; populate an untracked .env
# with the real values once staging/production access is confirmed
# (Infrastructure Confirmation #3), after the credential-rotation
# prerequisite in Blueprint §8 has been completed.
DB_MAIN_HOST=
DB_MAIN_PORT=3306
DB_MAIN_DATABASE=
DB_MAIN_USERNAME=
DB_MAIN_PASSWORD=

DB_VBULLETIN_HOST=
DB_VBULLETIN_PORT=3306
DB_VBULLETIN_DATABASE=
DB_VBULLETIN_USERNAME=
DB_VBULLETIN_PASSWORD=

DB_FLASHCHAT_HOST=
DB_FLASHCHAT_PORT=3306
DB_FLASHCHAT_DATABASE=
DB_FLASHCHAT_USERNAME=
DB_FLASHCHAT_PASSWORD=

# Wave 0, task 0.3 (ADR-0011) — required by VbulletinSessionGuard to validate
# the bb_password cookie. Left blank here deliberately; see
# config/services.php's TODO for where the current legacy value lives.
VBULLETIN_COOKIE_SALT=
# Forum auth-cookie prefix ({prefix}sessionhash / {prefix}userid / {prefix}password). Verify the production forum cookie_prefix before setting.
VBULLETIN_COOKIE_PREFIX=bb_
# D1 (2026-11-09): forum session IP binding, mirrored from the forum's own settings (verify before changing):
# vBulletin options `ipcheck` / `cookietimeout`, and config.php $config['Misc']['proxyiplist'] / ['proxyipheader'].
# Defaults reproduce the previous behaviour. proxyiplist "all" / "*" is refused; VBULLETIN_IPCHECK=4 (no IP binding)
# also needs VBULLETIN_IPCHECK_ALLOW_UNBOUND=true. Malformed values make forum session cookies fail closed (logged).
VBULLETIN_IPCHECK=1
VBULLETIN_IPCHECK_ALLOW_UNBOUND=false
VBULLETIN_COOKIE_TIMEOUT=900
VBULLETIN_PROXY_IP_LIST=
VBULLETIN_PROXY_IP_HEADER=

# Wave 0 completion review: 'file' instead of Laravel's stock 'database' —
# the users/password_reset_tokens/sessions migration was removed along with
# the unused stock User model, so a database session table no longer
# exists. Revisit alongside the cache-store choice (config/cache.php) once
# a real hosting environment (Infrastructure Confirmation #1) is confirmed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production template value (2026-11-09): send the session and XSRF-TOKEN cookies only over HTTPS. Unset, Laravel marks
# them Secure only when PHP itself sees an HTTPS request — which is false behind a TLS-terminating proxy that is not
# trusted (Trusted Proxies remain open). TEMPLATE ONLY — enable on the server only once the site is served over HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Blueprint v1.0 §13 — 'file' for local dev; Redis is deferred pending
# Infrastructure Confirmation #2 (see config/cache.php).
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enhancement Batch E-01 — performance observability. All optional; the
# defaults in config/performance.php apply when these are absent.
# Thresholds are milliseconds. See docs/operations/performance-monitoring.md.
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_WARNING_MS=400
PERFORMANCE_SLOW_MS=1000
PERFORMANCE_CRITICAL_MS=2500
PERFORMANCE_SLOW_QUERY_MS=200
PERFORMANCE_LOG_RETENTION_DAYS=14
