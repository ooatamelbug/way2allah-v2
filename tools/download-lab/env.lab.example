# Way2Allah LOCAL LAB ONLY — disposable Docker environment; no production values.
APP_NAME=W2ALab
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate locally>
APP_URL=http://127.0.0.1:18081
LOG_CHANNEL=single
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=w2a-lab-db
DB_PORT=3306
DB_DATABASE=w2a_lab
DB_USERNAME=root
DB_PASSWORD=<generate locally>
DB_MAIN_HOST=w2a-lab-db
DB_MAIN_PORT=3306
DB_MAIN_DATABASE=w2a_lab
DB_MAIN_USERNAME=root
DB_MAIN_PASSWORD=<generate locally>
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
MEDIA_BASE_URL=/media
THUMBNAIL_BASE_URL=/thumbnails.php
# Download capacity (lab values; production values must be read from production, not assumed)
DOWNLOAD_CAPACITY_GUARD=true
DOWNLOAD_CAPACITY_MAX_CONCURRENT=20
DOWNLOAD_CAPACITY_RETRY_AFTER=60
DOWNLOAD_REJECTION_LOG=true
DOWNLOAD_REMOTE_CONNECT_TIMEOUT=15
DOWNLOAD_REMOTE_IDLE_TIMEOUT=10
# Telemetry / archive: shipped defaults (off); scenarios switch them explicitly
DOWNLOAD_TELEMETRY_SPOOL=off
DOWNLOAD_TELEMETRY_EVENTS=off
DOWNLOAD_TELEMETRY_AGGREGATE=off
DOWNLOAD_TELEMETRY_PRUNE=off
DOWNLOAD_REJECTIONS_ARCHIVE=false
