APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo
ASSET_BASE_URL="${APP_URL}"
MEDIA_BASE_URL="${ASSET_BASE_URL}/media"
THUMBNAIL_BASE_URL="${ASSET_BASE_URL}/thumbnails.php"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Wave 0, task 0.2 (Blueprint v1.0 §8 / ADR-0011 / P-006) — required before
# the 'main'/'vbulletin'/'flashchat' connections in config/database.php can
# be used. Values are intentionally left blank here — do not fill this file
# with real or plausible-looking credentials; populate an untracked .env
# with the real values once staging/production access is confirmed
# (Infrastructure Confirmation #3), after the credential-rotation
# prerequisite in Blueprint §8 has been completed.
DB_MAIN_HOST=
DB_MAIN_PORT=3306
DB_MAIN_DATABASE=
DB_MAIN_USERNAME=
DB_MAIN_PASSWORD=

DB_VBULLETIN_HOST=
DB_VBULLETIN_PORT=3306
DB_VBULLETIN_DATABASE=
DB_VBULLETIN_USERNAME=
DB_VBULLETIN_PASSWORD=

DB_FLASHCHAT_HOST=
DB_FLASHCHAT_PORT=3306
DB_FLASHCHAT_DATABASE=
DB_FLASHCHAT_USERNAME=
DB_FLASHCHAT_PASSWORD=

# Wave 0, task 0.3 (ADR-0011) — required by VbulletinSessionGuard to validate
# the bb_password cookie. Left blank here deliberately; see
# config/services.php's TODO for where the current legacy value lives.
VBULLETIN_COOKIE_SALT=

# Wave 0 completion review: 'file' instead of Laravel's stock 'database' —
# the users/password_reset_tokens/sessions migration was removed along with
# the unused stock User model, so a database session table no longer
# exists. Revisit alongside the cache-store choice (config/cache.php) once
# a real hosting environment (Infrastructure Confirmation #1) is confirmed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Blueprint v1.0 §13 — 'file' for local dev; Redis is deferred pending
# Infrastructure Confirmation #2 (see config/cache.php).
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Enhancement Batch E-01 — performance observability. All optional; the
# defaults in config/performance.php apply when these are absent.
# Thresholds are milliseconds. See docs/operations/performance-monitoring.md.
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_WARNING_MS=400
PERFORMANCE_SLOW_MS=1000
PERFORMANCE_CRITICAL_MS=2500
PERFORMANCE_SLOW_QUERY_MS=200
PERFORMANCE_LOG_RETENTION_DAYS=14
